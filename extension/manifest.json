{
  "manifest_version": 3,
  "name": "Watch Party",
  "version": "2.2.2",
  "description": "Watch Netflix, Prime Video, and JioHotstar in sync with friends.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.amazon.com/gp/video/*",
    "https://www.jiohotstar.com/*",
    "https://www.hotstar.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Watch Party"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.jiohotstar.com/*",
        "https://www.hotstar.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "116"
}
